{
  "name": "freestack-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "KVLITE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "MCP_AUTH_TOKEN": "REPLACE_WITH_LONG_RANDOM_TOKEN"
  }
}
