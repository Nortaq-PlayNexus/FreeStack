# Environment template for the whole stack
# Copy to .env and fill in. Never commit .env.
# Reference: every key each folder reads. Unused keys can stay empty.

# --- Cloudflare (free account: cloudflare.com) ---
CLOUDFLARE_API_TOKEN=                 # My Profile -> API Tokens (Edit zone DNS + Workers R2)
CLOUDFLARE_ACCOUNT_ID=                # dashboard right side of URL (also used as CF_ACCOUNT_ID)
CF_ACCOUNT_ID=                        # same as above
CF_ZONE_ID=                           # zone -> Overview -> right side
CF_PAGES_PROJECT=freestack            # Cloudflare Pages project name (01)
FREESTACK_API_URL=                    # https://<worker>.<your-subdomain>.workers.dev (13, audit)

# --- GitHub (free account: github.com) ---
GITHUB_REPO=yourname/freestack        # owner/name
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx # classic PAT: repo + workflow scope (10/runner-install.sh)

# --- Domains (12) ---
ISADEV_SUBDOMAIN=yourname             # want yourname.is-a.dev
DOMAIN=yourname.is-a.dev              # full domain after PR merges
DUCKDNS_DOMAIN=                       # no .duckdns.org suffix
DUCKDNS_TOKEN=

# --- Databases (06) ---
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/freestack?sslmode=require
DATABASE_URL=                         # generic pg url (backup.sh falls back to this)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx
TURSO_DATABASE_URL=
PG_PASSWORD=                          # for self-hosted postgres-compose.yml
RCLONE_REMOTE=r2:freestack-backups    # backups destination (08)

# --- Email (09) ---
EMAIL_FROM=you@yourname.is-a.dev      # verified sender (resend/brevo/gmail)
EMAIL_ALERT_TO=you@example.com        # where alerts go
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx    # resend.com (3000/mo)
BREVO_API_KEY=                        # brevo.com fallback (300/day)
GMAIL_USER=                           # fallback via Gmail SMTP (500/day)
GMAIL_APP_PASSWORD=

# --- LLM / AI (05) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxx    # openrouter.ai free models
KILO_API_KEY=                        # kilo.ai (no key needed)
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# --- Search / RAG (14) ---
MEILI_URL=http://localhost:7700
MEILI_KEY=devkeychangeit
MEILI_INDEX=docs
MEILI_MASTER_KEY=devkeychangeit

# --- Storage (08) ---
RCLONE_CONFIG_PATH=                   # rclone config file location
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
B2_KEY_ID=
B2_APP_KEY=
B2_APPLICATION_KEY=

# --- Monitoring (11) ---
BETTERSTACK_UPTIME_TOKEN=             # betterstack.com Settings -> Tokens
HEALTHCHECKS_PING_KEY=                # healthchecks.io check ping key

# --- VMs (07) ---
ORACLE_TENANCY_OCID=
ORACLE_USER_OCID=
ORACLE_FINGERPRINT=
ORACLE_REGION=eu-frankfurt-1
ORACLE_COMPARTMENT_OCID=
ORACLE_SSH_PUBKEY_PATH=~/.ssh/id_ed25519.pub
GCP_PROJECT_ID=
GCP_REGION=us-central1
